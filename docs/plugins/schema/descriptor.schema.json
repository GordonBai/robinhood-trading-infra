{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy plugin descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "plugin_id",
    "version",
    "state_schema",
    "config_schema",
    "data_requirements",
    "capabilities",
    "feature_keys",
    "exit_rule",
    "warmup_bars",
    "history_bars"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
    },
    "state_schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "config_schema": {
      "type": "object"
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "quotes",
          "5minute-bars",
          "universe-screen"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_rule": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "warmup_bars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "history_bars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    }
  }
}
